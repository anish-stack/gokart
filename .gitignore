# ==========================================

# GO! Track Express - Root Git Ignore

# ==========================================

# ------------------------------------------

# Dependencies

# ------------------------------------------

node_modules/
**/node_modules/

# ------------------------------------------

# Environment files / Secrets

# ------------------------------------------

.env
.env.*
!.env.example
!.env.sample

# ------------------------------------------

# Logs

# ------------------------------------------

*.log
logs/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ------------------------------------------

# Backend

# ------------------------------------------

backend/dist/
backend/build/
backend/coverage/
backend/.cache/

# Backend uploads - user generated files

# 

# Database files

backend/*.db
backend/*.sqlite
backend/*.sqlite3
backend/data/

# ------------------------------------------

# Expo / React Native

# ------------------------------------------

mobile/.expo/
mobile/.expo-shared/
mobile/web-build/

# Android

mobile/android/.gradle/
mobile/android/build/
mobile/android/app/build/
mobile/android/.cxx/
mobile/android/local.properties

# iOS

mobile/ios/Pods/
mobile/ios/build/
mobile/ios/DerivedData/

# Expo / EAS

mobile/.eas/
mobile/eas-build/

# Metro

mobile/.metro-health-check*

# ------------------------------------------

