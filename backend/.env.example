# Server
NODE_ENV=development
PORT=4000

# Database
DATABASE_URL=mongodb://localhost:27017/go_track_express

# Auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d

# Tracking provider: demo | awb
TRACKING_PROVIDER=demo
AWB_API_URL=https://example.com/awb-provider
AWB_API_KEY=replace-with-real-awb-api-key

# Firebase Admin (FCM)
FIREBASE_PROJECT_ID=replace-with-firebase-project-id
FIREBASE_CLIENT_EMAIL=replace-with-firebase-client-email
FIREBASE_PRIVATE_KEY="replace-with-firebase-private-key"

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:19006

# Redis
REDIS_URL=redis://localhost:6379
